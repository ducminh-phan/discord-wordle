{
  "name": "discord-wordle",
  "version": "1.0.0",
  "description": "Discord bot to post Wordle solutions",
  "main": "index.js",
  "repository": "https://github.com/ducminh-phan/discord-wordle",
  "author": "Duc-Minh Phan <alephvn@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "deploy": "dotenv -- serverless deploy",
    "dev": "dotenv -e .env.local -- serverless invoke local --function default",
    "format": "prettier --write src",
    "lint": "eslint --cache --fix src",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "serverless": "^4.33.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dayjs": "^1.11.19"
  }
